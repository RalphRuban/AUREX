# =========================================================
# AI RISK GUARD - ENVIRONMENT CONFIGURATION
# =========================================================

# 1. GITHUB APP CREDENTIALS
# The App ID from your GitHub App settings
GITHUB_APP_ID=your_github_app_id_here

# The Webhook Secret for signature verification
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# The Marketplace Webhook Secret for GitHub Marketplace purchase events
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_MARKETPLACE_WEBHOOK_SECRET=

# GitHub OAuth login (Client ID + Client Secret from the SAME GitHub App:
# Permissions → under "GitHub App" → OAuth. Or create a separate OAuth App
# at github.com/settings/developers).
GITHUB_APP_CLIENT_ID=your_github_client_id_here
GITHUB_APP_CLIENT_SECRET=your_github_client_secret_here

# The GitHub App slug (URL-friendly name) used to build the app-installation
# link shown to users who haven't installed the app yet.
# Example: if your app is at https://github.com/apps/my-security-bot, use "my-security-bot".
GITHUB_APP_SLUG=your_app_slug_here

# The Private Key: Provide either the raw PEM content (escaped)
# or the absolute path to your .pem file.
# GITHUB_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
GITHUB_PRIVATE_KEY=C:/path/to/your/private-key.pem

# 2. AI & LLM SETTINGS
# Google Gemini API Key (Free tier available at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. APPLICATION SETTINGS
# Production mode: when set to 'production', startup fails (instead of warning)
# if any required GITHUB_* secret or FLASK_SECRET_KEY is missing.
# Leave unset for local development.
# APP_ENV=production

# Strict config loading (default on): malformed YAML or an invalid config value
# aborts startup instead of silently using defaults. Set to 0 to restore the
# lenient log-and-use-defaults behavior.
# CONFIG_STRICT=0

# Flask session secret key — REQUIRED for production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If not set, a random key is generated at startup and all sessions are
# invalidated on every restart.
FLASK_SECRET_KEY=your_random_secret_key_here

# Set to 'true' when serving over HTTPS (enables Secure session cookies).
# Keep empty/unset for local HTTP development.
# SESSION_COOKIE_SECURE=true

# Frontend origin — only needed when the frontend is served from a different
# origin than this backend (e.g., the Vite dev server: http://localhost:5173).
# Leave empty when the SPA is served from Flask's static/frontend (production).
# FRONTEND_ORIGIN=http://localhost:5173

# Database path (optional). Relative paths resolve against the repo root.
# In production set an absolute path (e.g. /opt/ai-risk-guard/data/dashboard.db).
# DB_PATH=data/dashboard.db

# Port override for platforms that inject $PORT (Render, Heroku, Cloud Run).
# If unset, the server binds to the port in config/app.yaml (default 8000).
# PORT=8000

# 4. DEPLOYMENT / OBSERVABILITY

# Public dashboard URL shown in the PR comment footer.
# If unset, falls back to the `deployment.dashboard_url` config, then localhost.
# APP_DASHBOARD_URL=https://your-host/dashboard

# SARIF tool informationUri (the project URL embedded in generated SARIF).
# If unset, falls back to the `deployment.sarif_information_uri` config, then the default.
# SARIF_INFORMATION_URI=https://github.com/you/ai-risk-guard

# Prometheus scrape token. When set, /api/metrics/prometheus is accessible with
# `Authorization: Bearer <token>` (no browser session). When unset, the endpoint
# requires a normal authenticated dashboard session.
# METRICS_SCRAPE_TOKEN=your_metrics_scrape_token_here

# CI-runner fallback validation (Phase E): when Docker is unavailable locally,
# candidates that failed closed are validated on a GitHub-hosted runner via
# repository_dispatch, then results are re-injected into a re-analysis pass.
# CI_VALIDATION_SECRET must match the `AI_RISK_GUARD_CI_SECRET` Actions secret
# on the workflow repo that hosts ai-risk-guard-validate.yml.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# CI_VALIDATION_SECRET=your_ci_validation_secret_here

# Public base URL the runner uses to fetch jobs and post results. Falls back to
# the `ci_runner.base_url` config in config/app.yaml.
# CI_VALIDATION_BASE_URL=https://your-host

# Optional GitHub token with repo scope on the workflow repo used for the
# repository_dispatch. When unset, dispatch falls back to the repo's own
# installation token.
# CI_VALIDATION_TOKEN=github_token_with_repo_scope

# Logging level override (DEBUG/INFO/WARNING/ERROR). Defaults to the
# `logging.level` config (INFO in production).
# LOG_LEVEL=INFO
